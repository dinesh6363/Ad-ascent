---
import "@fontsource-variable/inter";
import "../styles/theme.css";
import { site, SITE_URL, questions } from "../config";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Ad-Ascent", description = site.description } = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL("/og-image.png", SITE_URL).href;

const orgLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.name,
  description: site.description,
  url: SITE_URL,
  logo: new URL("/logo-mark.svg", SITE_URL).href,
  image: ogImage,
  email: site.contactEmail,
  areaServed: [
    { "@type": "Country", name: "United States" },
    { "@type": "AdministrativeArea", name: "Worldwide" },
  ],
  serviceType: "Customer acquisition for home service businesses",
  slogan: "Make the trust you've earned offline obvious online.",
  sameAs: [site.linkedinUrl].filter((u) => !u.includes("{{")),
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: questions.items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Set theme before first paint to avoid a flash of the wrong theme. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          document.documentElement.setAttribute("data-theme", stored === "dark" ? "dark" : "light");
        } catch (e) {}
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light dark" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Ad-Ascent — make the trust you've earned offline obvious online"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

    <noscript>
      <style>
        [data-reveal],
        [data-depth] {
          opacity: 1 !important;
          transform: none !important;
        }
        .page-fade {
          opacity: 1 !important;
        }
      </style>
    </noscript>
  </head>
  <body class="page-fade">
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />

    <script>
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Opening reveal — the page gently fades itself in.
      requestAnimationFrame(() => document.body.classList.add("is-ready"));

      // 0) Theme toggle ---------------------------------------------------
      const THEME_KEY = "theme";
      const themeMeta = document.querySelector('meta[name="theme-color"]');
      const syncThemeColor = () => {
        if (!themeMeta) return;
        const bg = getComputedStyle(document.documentElement).getPropertyValue("--color-bg").trim();
        if (bg) themeMeta.setAttribute("content", bg);
      };
      syncThemeColor();
      document.querySelectorAll<HTMLButtonElement>(".theme-toggle").forEach((btn) => {
        btn.addEventListener("click", () => {
          const current =
            document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
          const next = current === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          try {
            localStorage.setItem(THEME_KEY, next);
          } catch (e) {
            /* ignore */
          }
          syncThemeColor();
        });
      });

      // 1) Scroll-reveal --------------------------------------------------
      const revealEls = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (reduce || !("IntersectionObserver" in window)) {
        revealEls.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.14, rootMargin: "0px 0px -8% 0px" },
        );
        revealEls.forEach((el) => io.observe(el));
      }

      // 2) Header state + scroll-spy --------------------------------------
      const header = document.getElementById("site-header");
      const spyLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-spy-link]"));
      const sections = spyLinks
        .map((l) => document.querySelector<HTMLElement>(l.getAttribute("href") || ""))
        .filter((s): s is HTMLElement => Boolean(s));

      const onScroll = () => {
        if (header) header.classList.toggle("is-scrolled", window.scrollY > 12);
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      if (sections.length) {
        const spy = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const id = entry.target.id;
                spyLinks.forEach((l) =>
                  l.classList.toggle("is-active", l.getAttribute("href") === `#${id}`),
                );
              }
            });
          },
          { rootMargin: "-45% 0px -50% 0px" },
        );
        sections.forEach((s) => spy.observe(s));
      }

      // 3) "Going deeper" depth-scroll ------------------------------------
      // Each main section recedes a touch (dims) once its centre passes above
      // the viewport centre, so scrolling feels like descending through layers.
      // Opacity only — scaling a tall section would pull its bottom up and make
      // the gap to the next section vary by height, so the recede never resizes.
      if (!reduce) {
        const depthEls = Array.from(document.querySelectorAll<HTMLElement>("main > section"));
        depthEls.forEach((s) => s.setAttribute("data-depth", ""));
        let ticking = false;
        const applyDepth = () => {
          ticking = false;
          const vh = window.innerHeight;
          depthEls.forEach((s) => {
            const r = s.getBoundingClientRect();
            const center = r.top + r.height / 2;
            // How far the section's centre has passed above the viewport centre.
            // Deadzone (0.2) so the section in focus — and the hero on load —
            // stays fully forward; only clearly-passed sections recede.
            const t = (vh / 2 - center) / vh - 0.2;
            s.style.opacity = t > 0 ? String(Math.max(0.74, 1 - t * 0.42)) : "";
          });
        };
        const onDepth = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(applyDepth);
          }
        };
        applyDepth();
        window.addEventListener("scroll", onDepth, { passive: true });
        window.addEventListener("resize", onDepth);
      }

      // 4) Mobile menu ----------------------------------------------------
      const menuBtn = document.getElementById("menu-toggle");
      const mobileMenu = document.getElementById("mobile-menu");
      const setMenu = (open: boolean) => {
        if (!menuBtn || !mobileMenu) return;
        menuBtn.setAttribute("aria-expanded", String(open));
        mobileMenu.classList.toggle("is-open", open);
        document.body.style.overflow = open ? "hidden" : "";
      };
      menuBtn?.addEventListener("click", () =>
        setMenu(menuBtn.getAttribute("aria-expanded") !== "true"),
      );
      mobileMenu
        ?.querySelectorAll("a")
        .forEach((a) => a.addEventListener("click", () => setMenu(false)));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setMenu(false);
      });
    </script>
  </body>
</html>
