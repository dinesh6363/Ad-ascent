---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Why from "../components/Why.astro";
import ArticleTeaser from "../components/ArticleTeaser.astro";
import How from "../components/How.astro";
import Team from "../components/Team.astro";
import Conversation from "../components/Conversation.astro";
import Questions from "../components/Questions.astro";
import CtaBook from "../components/CtaBook.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
---

<Layout>
