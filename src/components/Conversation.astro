---
import { conversation } from "../config";
---

<section id="conversation" class="relative py-16">
  <div class="container">
    <div class="mx-auto max-w-2xl text-center">
      <p data-reveal class="eyebrow">{conversation.overline}</p>
      <h2
        data-reveal
        style="--reveal-delay:60ms"
        class="mt-3 text-3xl font-extrabold tracking-tight text-text sm:text-4xl"
      >
        {conversation.opening}
      </h2>
    </div>

    <ol class="relative mx-auto mt-14 max-w-3xl">
      <span
        class="absolute bottom-3 top-3 left-[9px] w-px bg-gradient-to-b from-primary via-accent to-primary sm:left-1/2 sm:-translate-x-1/2"
        aria-hidden="true"></span>
      {
        conversation.steps.map((step, i) => (
          <li
            data-reveal
            class="relative mb-8 pl-10 last:mb-0 sm:grid sm:grid-cols-2 sm:gap-12 sm:pl-0"
          >
            <span
              class="absolute top-2 left-0 grid h-5 w-5 place-items-center rounded-full bg-gradient-to-br from-primary to-accent text-[10px] font-bold text-white ring-4 ring-bg sm:left-1/2 sm:-translate-x-1/2"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <div class={i % 2 === 0 ? "sm:col-start-1 sm:pr-10" : "sm:col-start-2 sm:pl-10"}>
              <div
                class:list={[
                  "rounded-[var(--radius-lg)] border p-5 transition-all duration-300 hover:-translate-y-0.5",
                  step.emphasis
                    ? "border-primary/40 bg-gradient-to-br from-primary/10 to-accent/10"
                    : "border-border bg-surface/50 hover:border-primary/40",
                ]}
              >
                <h3 class="text-lg font-bold text-text">{step.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{step.body}</p>
                {"questions" in step && step.questions && (
                  <ul class="mt-4 space-y-2">
                    {step.questions.map((q) => (
                      <li class="flex gap-2.5 text-sm text-text">
                        <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gradient-to-br from-primary to-accent" aria-hidden="true" />
                        {q}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="mx-auto mt-12 max-w-prose text-center">
      <p data-reveal class="text-lg leading-relaxed text-muted">{conversation.conclusion}</p>
      <p
        data-reveal
        style="--reveal-delay:80ms"
        class="text-gradient mt-4 text-2xl font-extrabold leading-snug"
      >
        {conversation.belief}
      </p>
    </div>
  </div>
</section>
