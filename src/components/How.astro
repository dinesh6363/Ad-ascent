---
import { how } from "../config";
import SectionHeading from "./SectionHeading.astro";
import JourneyDiagram from "./JourneyDiagram.astro";
---

<section id="how" class="relative py-16">
  <div class="container">
    <SectionHeading overline={how.overline} title={how.heading} align="center" />

    <div class="mt-12">
      <JourneyDiagram />
    </div>

    <div class="mx-auto mt-12 max-w-prose space-y-3 text-center text-lg leading-relaxed text-muted">
      <p data-reveal>{how.intro}</p>
      <p data-reveal style="--reveal-delay:80ms">{how.intro2}</p>
    </div>

    <!-- Philosophy cards: heading, then tag, then one line per statement -->
    <div class="mx-auto mt-10 grid max-w-4xl gap-5 sm:grid-cols-2">
      {
        how.philosophy.map((stage, i) => (
          <article
            data-reveal
            style={`--reveal-delay:${(i % 2) * 90}ms`}
            class="group relative overflow-hidden rounded-[var(--radius-lg)] border border-border bg-surface/50 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-[0_20px_50px_-24px_var(--glow-primary)]"
          >
            <h3 class="text-lg font-bold text-text">{stage.title}</h3>
            <span class="mt-2.5 inline-block rounded-full border border-border bg-bg/50 px-2.5 py-1 text-[0.62rem] font-semibold uppercase tracking-wider text-muted">
              {stage.tag}
            </span>
            <div class="mt-4 space-y-2.5 text-sm leading-relaxed text-muted">
              {stage.lines.map((line) => (
                <p>{line}</p>
              ))}
            </div>
          </article>
        ))
      }
    </div>

    <p
      data-reveal
      class="mx-auto mt-12 max-w-prose text-center text-xl font-semibold leading-snug text-text sm:text-2xl"
    >
      {how.closing}
    </p>
  </div>
</section>
