---
import { article } from "../config";
import Icon from "./Icon.astro";
---

<section id="article" class="relative py-16">
  <div class="container">
    <a
      data-reveal
      href={article.href}
      class="bg-surface/50 hover:border-primary/40 group mx-auto block max-w-4xl rounded-[var(--radius-lg)] border border-border p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_50px_-24px_var(--glow-primary)] sm:p-10"
    >
      <h3 class="text-sm font-bold uppercase tracking-[0.12em] text-text sm:text-base">
        {article.overline}
      </h3>

      <p class="mt-5 text-lg font-semibold leading-snug text-text">
        {article.lead}
      </p>

      <p class="mt-4 text-base leading-relaxed text-muted">
        {article.teaser}
      </p>

      <span class="mt-6 inline-flex items-center gap-2 text-base font-bold text-text">
        {article.cta}
        <Icon
          name="arrow"
          class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
        />
      </span>
    </a>
  </div>
</section>
