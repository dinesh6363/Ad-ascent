---
import { articles } from "../config";
import Icon from "./Icon.astro";
---

<section id="articles" class="relative py-16">
  <div class="container">
    <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2">
      {
        articles.map((article, i) => (
          <a
            data-reveal
            style={`--reveal-delay:${i * 80}ms`}
            href={article.href}
            class="bg-surface/50 hover:border-primary/40 group flex flex-col rounded-[var(--radius-lg)] border border-border p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_50px_-24px_var(--glow-primary)] sm:p-10"
          >
            <h3 class="text-sm font-bold uppercase tracking-[0.12em] text-text sm:text-base">
              {article.overline}
            </h3>

            <p class="mt-5 text-lg font-semibold leading-snug text-text">{article.lead}</p>

            <p class="mt-4 text-base leading-relaxed text-muted">{article.teaser}</p>

            <span class="mt-auto inline-flex items-center gap-2 pt-6 text-base font-bold text-text">
              {article.cta}
              <Icon
                name="arrow"
                class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
              />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
