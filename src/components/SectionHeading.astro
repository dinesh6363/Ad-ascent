---
/** Consistent section header: optional overline + title + optional lead. */
interface Props {
  overline?: string;
  title?: string;
  lead?: string;
  align?: "left" | "center";
  class?: string;
}
const { overline, title, lead, align = "center", class: className = "" } = Astro.props;
const alignCls =
  align === "center" ? "mx-auto items-center text-center" : "items-start text-left";
---

<div class={`flex max-w-2xl flex-col ${alignCls} ${className}`}>
  {overline && <p data-reveal class="eyebrow mb-3">{overline}</p>}
  {
    title && (
      <h2
        data-reveal
        style="--reveal-delay:60ms"
        class="text-3xl font-extrabold tracking-tight text-text sm:text-[2.6rem] sm:leading-[1.1]"
      >
        {title}
      </h2>
    )
  }
  {
    lead && (
      <p data-reveal style="--reveal-delay:120ms" class="mt-4 text-lg leading-relaxed text-muted">
        {lead}
      </p>
    )
  }
</div>
