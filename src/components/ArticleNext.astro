---
import Icon from "./Icon.astro";

/**
 * "Keep reading" link to another article, shown at the foot of an article.
 * Uses <span>s rather than <p>/<h*> so the .article-prose typography doesn't
 * reach into it.
 */
interface Props {
  article: { href: string; title: string; lead: string };
  label?: string;
}

const { article, label = "Keep reading" } = Astro.props;
---

<a
  href={article.href}
  class="bg-surface/50 hover:border-primary/40 group mt-6 block rounded-[var(--radius-lg)] border border-border p-6 no-underline transition-all duration-300 hover:-translate-y-0.5 sm:p-8"
>
  <span class="eyebrow block">{label}</span>
  <span class="mt-3 block text-lg font-bold leading-snug text-text">{article.title}</span>
  <span class="mt-2 block text-sm leading-relaxed text-muted">{article.lead}</span>
  <span class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-text">
    Read the article
    <Icon
      name="arrow"
      class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
    />
  </span>
</a>
