---
import { how } from "../config";
const d = how.diagram;
---

<!--
  Customer-acquisition system diagram (matches the reference flowchart):
  two perspectives → converge at the handshake → learning → optimisation, with a
  light feedback loop that rises back to the converge level. Builds in sequence
  when scrolled into view.
-->
<div
  data-journey
  class="journey relative mx-auto max-w-3xl overflow-hidden rounded-[var(--radius-lg)] border border-border-strong bg-surface/50 p-4 backdrop-blur sm:p-6"
>
  <div class="pointer-events-none absolute -right-24 -top-24 h-64 w-64 rounded-full bg-[radial-gradient(circle,var(--glow-accent),transparent_70%)]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-24 -left-24 h-64 w-64 rounded-full bg-[radial-gradient(circle,var(--glow-primary),transparent_70%)]" aria-hidden="true"></div>

  <div class="relative overflow-x-auto">
    <svg
      viewBox="0 0 700 740"
      role="img"
      aria-label="Customer acquisition system: the customer's perspective and the business's perspective converge when a customer chooses you, creating learning (analytics & tracking) and continuous optimisation (optimisation & automation) that feeds back into the whole system."
      class="mx-auto w-full min-w-[640px] max-w-[700px]"
      font-family="'Inter Variable', Inter, sans-serif"
    >
      <defs>
        <marker id="ah" viewBox="0 0 10 10" refX="7.5" refY="5" markerWidth="6" markerHeight="6" orient="auto">
          <path d="M0.5 1 L8 5 L0.5 9" fill="none" stroke="var(--color-muted)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </marker>
        <marker id="ahUp" viewBox="0 0 10 10" refX="7.5" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
          <path d="M0.5 1 L8 5 L0.5 9" fill="none" stroke="var(--color-faint)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </marker>
      </defs>

      <!-- Feedback loop (light, unfocused): rails originate from the left and
           right sides of the centred optimise node and rise until each arrow
           reaches its service label — left to "Google Ads / SEO", right to
           "Website Development · Content Writing" (which sits higher). -->
      <g class="diag-item" style="--d:1000ms">
        <path d="M228 626 H98 Q92 626 92 620 V272" fill="none" stroke="var(--color-border-strong)" stroke-width="1" marker-end="url(#ahUp)"/>
        <path d="M472 626 H609 Q615 626 615 620 V190" fill="none" stroke="var(--color-border-strong)" stroke-width="1" marker-end="url(#ahUp)"/>
      </g>

      <!-- Columns + steps -->
      <g class="diag-item" fill="var(--color-text)" style="--d:0ms">
        <!-- headers -->
        <text x="230" y="40" text-anchor="middle" font-size="12" font-weight="700" letter-spacing="1.2" fill="var(--color-muted)">CUSTOMER'S PERSPECTIVE</text>
        <line x1="152" y1="50" x2="308" y2="50" stroke="var(--color-border-strong)" stroke-width="1"/>
        <text x="470" y="40" text-anchor="middle" font-size="12" font-weight="700" letter-spacing="1.2" fill="var(--color-muted)">BUSINESS'S PERSPECTIVE</text>
        <line x1="392" y1="50" x2="548" y2="50" stroke="var(--color-border-strong)" stroke-width="1"/>

        <!-- left steps -->
        <text x="230" y="102" text-anchor="middle" font-size="12.5" font-weight="600">Needs a service</text>
        <line x1="230" y1="114" x2="230" y2="146" stroke="var(--color-muted)" stroke-width="1.4" marker-end="url(#ah)"/>
        <text x="230" y="172" text-anchor="middle" font-size="12.5" font-weight="600">Searches for a</text>
        <text x="230" y="188" text-anchor="middle" font-size="12.5" font-weight="600">competent provider</text>
        <line x1="230" y1="202" x2="230" y2="234" stroke="var(--color-muted)" stroke-width="1.4" marker-end="url(#ah)"/>
        <text x="230" y="256" text-anchor="middle" font-size="12.5" font-weight="600">Finds your business</text>

        <!-- right steps -->
        <text x="470" y="96" text-anchor="middle" font-size="12.5" font-weight="600">A trustworthy</text>
        <text x="470" y="112" text-anchor="middle" font-size="12.5" font-weight="600">business exists</text>
        <line x1="470" y1="126" x2="470" y2="146" stroke="var(--color-muted)" stroke-width="1.4" marker-end="url(#ah)"/>
        <text x="470" y="172" text-anchor="middle" font-size="12.5" font-weight="600">Makes that trust</text>
        <text x="470" y="188" text-anchor="middle" font-size="12.5" font-weight="600">visible online</text>
        <line x1="470" y1="202" x2="470" y2="234" stroke="var(--color-muted)" stroke-width="1.4" marker-end="url(#ah)"/>
        <text x="470" y="250" text-anchor="middle" font-size="12.5" font-weight="600">Customers</text>
        <text x="470" y="266" text-anchor="middle" font-size="12.5" font-weight="600">discover you</text>
      </g>

      <!-- Left service: dashed line from "Finds your business" points AT the label -->
      <g class="diag-item" style="--d:220ms">
        <text x="92" y="249" text-anchor="middle" font-size="10.5" font-weight="700" letter-spacing="0.5" fill="var(--color-primary)">Google Ads</text>
        <text x="92" y="267" text-anchor="middle" font-size="10.5" font-weight="700" letter-spacing="0.5" fill="var(--color-primary)">SEO</text>
        <circle cx="166" cy="253" r="2.2" fill="var(--color-primary)"/>
        <line x1="162" y1="253" x2="122" y2="253" stroke="var(--color-primary)" stroke-width="1.2" stroke-dasharray="2 3"/>
      </g>

      <!-- Right service: dashed line from "Makes that trust visible online" points AT the label -->
      <g class="diag-item" style="--d:280ms">
        <text x="558" y="170" font-size="10.5" font-weight="700" letter-spacing="0.5" fill="var(--color-primary)">Website Development ·</text>
        <text x="558" y="184" font-size="10.5" font-weight="700" letter-spacing="0.5" fill="var(--color-primary)">Content Writing</text>
        <circle cx="524" cy="172" r="2.2" fill="var(--color-primary)"/>
        <line x1="528" y1="172" x2="558" y2="172" stroke="var(--color-primary)" stroke-width="1.2" stroke-dasharray="2 3"/>
      </g>

      <!-- Converge into the handshake -->
      <g class="diag-item" style="--d:420ms">
        <path d="M230 268 V348 Q230 360 244 360 H304" fill="none" stroke="var(--color-muted)" stroke-width="1.4" marker-end="url(#ah)"/>
        <path d="M470 276 V348 Q470 360 456 360 H396" fill="none" stroke="var(--color-muted)" stroke-width="1.4" marker-end="url(#ah)"/>
        <circle cx="350" cy="360" r="36" fill="var(--color-bg)" stroke="var(--color-text)" stroke-width="1.4"/>
        <svg x="330" y="340" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--color-text)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="m11 17 2 2a1 1 0 1 0 3-3"/>
          <path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/>
          <path d="m21 3 1 11h-2"/>
          <path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/>
          <path d="M3 4h8"/>
        </svg>
        <path d="M350 398 V454" fill="none" stroke="var(--color-muted)" stroke-width="1.4" marker-end="url(#ah)"/>
      </g>

      <!-- Business learns (circle left, text right — the card is centred; arrow runs down the centre) -->
      <g class="diag-item" style="--d:600ms">
        <circle cx="255" cy="490" r="26" fill="var(--color-bg)" stroke="var(--color-text)" stroke-width="1.3"/>
        <svg x="241" y="476" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-text)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 20V11M10 20V5M16 20v-6"/><path d="M3 20h18"/>
        </svg>
        <text x="300" y="472" font-size="13.5" font-weight="700" fill="var(--color-text)">{d.learn.title}</text>
        <text x="300" y="491" font-size="11.5" fill="var(--color-muted)">We track what happens</text>
        <text x="300" y="507" font-size="11.5" fill="var(--color-muted)">and understand what matters.</text>
        <text x="300" y="530" font-size="12.5" font-weight="600" fill="var(--color-primary)">{d.learn.tag}</text>
        <path d="M350 546 V590" fill="none" stroke="var(--color-muted)" stroke-width="1.4" marker-end="url(#ah)"/>
      </g>

      <!-- Optimise & improve (circle left, text right — the card is centred; feedback rails join its sides) -->
      <g class="diag-item" style="--d:780ms">
        <circle cx="255" cy="626" r="26" fill="var(--color-bg)" stroke="var(--color-text)" stroke-width="1.3"/>
        <svg x="241" y="612" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-text)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
        <text x="300" y="608" font-size="13.5" font-weight="700" fill="var(--color-text)">{d.improve.title}</text>
        <text x="300" y="627" font-size="11.5" fill="var(--color-muted)">We improve campaigns, website</text>
        <text x="300" y="643" font-size="11.5" fill="var(--color-muted)">and customer experience.</text>
        <text x="300" y="666" font-size="12.5" font-weight="600" fill="var(--color-primary)">{d.improve.tag}</text>
      </g>
    </svg>
  </div>
</div>

<style>
  .diag-item {
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .journey.is-playing .diag-item {
    opacity: 1;
    transition-delay: var(--d, 0ms);
  }
</style>

<noscript>
  <style>
    .diag-item { opacity: 1 !important; }
  </style>
</noscript>

<script>
  const el = document.querySelector<HTMLElement>("[data-journey]");
  if (el) {
    if (!("IntersectionObserver" in window)) {
      el.classList.add("is-playing");
    } else {
      const io = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              el.classList.add("is-playing");
              obs.disconnect();
            }
          });
        },
        { threshold: 0.2 },
      );
      io.observe(el);
    }
  }
</script>
