---
import { hero } from "../config";
---

<!--
  Hero. On load it's a full-screen moment: only the big belief, centered.
  On the first small scroll it settles to normal size and the rest reveals —
  once per page load (it never replays, even scrolling back to the top).
-->
<section id="home" class="hero-sec relative overflow-hidden pt-32 pb-16 sm:pt-40">
  <div class="container">
    <div class="mx-auto text-center">
      <h1 class="hero-head font-extrabold tracking-tight text-text">
        {hero.beliefLine1}<br />
        {hero.beliefLine2Lead}<span class="text-gradient">{hero.beliefLine2Highlight}</span>
      </h1>

      <div id="hero-more" class="hero-more mt-8 space-y-4">
        <p class="mx-auto max-w-2xl text-xl font-semibold leading-snug text-text sm:text-2xl">
          {hero.observation}
        </p>
        <p class="mx-auto max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
          {hero.help}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-sec {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 0;
    transition: min-height 0.95s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* Full-screen intro state (added by JS on load). */
  .hero-sec.is-intro {
    min-height: 100svh;
  }

  .hero-head {
    font-size: clamp(2.1rem, 5.4vw, 3.6rem);
    line-height: 1.08;
    transition: font-size 0.95s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* Bigger on load — sized so each line stays on ONE line (two lines total). */
  .hero-sec.is-intro .hero-head {
    font-size: clamp(2.4rem, 5.4vw, 4.6rem);
    line-height: 1.06;
  }

  /* The supporting lines: hidden during the intro, revealed once it ends. */
  .hero-more p {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hero-more p:nth-child(2) {
    transition-delay: 130ms;
  }
  .hero-sec:not(.is-intro) .hero-more p {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  // Full-screen intro on load. Scrolling is LOCKED during the intro; the first
  // scroll intent is consumed to play the settle transition (the page stays
  // put), and scrolling is unlocked once the transition finishes. So the first
  // scroll only transitions; every scroll after that works normally.
  // One-time per page load; skipped for reduced-motion / no-JS / loaded mid-page.
  const hero = document.querySelector<HTMLElement>(".hero-sec");
  if (hero) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduce && window.scrollY <= 16) {
      const html = document.documentElement;
      hero.classList.add("is-intro");
      html.style.overflow = "hidden"; // lock scroll

      let done = false;
      const unlock = () => {
        html.style.overflow = "";
      };
      const cleanup = () => {
        window.removeEventListener("wheel", onIntent);
        window.removeEventListener("touchmove", onIntent);
        window.removeEventListener("keydown", onKey);
      };
      const settle = () => {
        if (done) return;
        done = true;
        hero.classList.remove("is-intro"); // play the transition
        cleanup();
        window.setTimeout(unlock, 1000); // unlock once it has settled
      };

      const onIntent = () => settle();
      const SCROLL_KEYS = new Set([
        " ",
        "Spacebar",
        "ArrowDown",
        "ArrowUp",
        "PageDown",
        "PageUp",
        "Home",
        "End",
      ]);
      const onKey = (e: KeyboardEvent) => {
        if (SCROLL_KEYS.has(e.key)) settle();
      };

      window.addEventListener("wheel", onIntent, { passive: true });
      window.addEventListener("touchmove", onIntent, { passive: true });
      window.addEventListener("keydown", onKey);

      // In-page nav links should skip straight to normal so navigation works.
      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
        a.addEventListener("click", () => {
          if (!done) {
            done = true;
            hero.classList.remove("is-intro");
            cleanup();
          }
          unlock();
        });
      });
    }
    // Otherwise (reduced motion / loaded mid-page / no-JS) it stays in the
    // normal state, with everything already visible via CSS.
  }
</script>
