---
import { team } from "../config";
---

<section id="team" class="relative py-16">
  <div class="container">
    <div class="mx-auto max-w-3xl text-center">
      <p data-reveal class="eyebrow">{team.overline}</p>
      <p
        data-reveal
        style="--reveal-delay:60ms"
        class="mt-3 text-[1.7rem] font-extrabold leading-tight tracking-tight text-text sm:text-4xl lg:whitespace-nowrap"
      >
        {team.transitionLead} <span class="text-gradient">{team.transitionEmphasis}</span>
      </p>
      <p data-reveal style="--reveal-delay:120ms" class="mt-5 text-lg leading-relaxed text-muted">
        {team.intro}
      </p>
    </div>

    <div class="mx-auto mt-12 grid max-w-4xl gap-5 sm:grid-cols-3">
      {
        team.members.map((m, i) => (
          <article
            data-reveal
            style={`--reveal-delay:${i * 90}ms`}
            class="group rounded-[var(--radius-lg)] border border-border bg-surface/50 p-6 text-center transition-all duration-300 hover:-translate-y-1 hover:border-accent/40"
          >
            <div class="relative mx-auto grid h-24 w-24 place-items-center overflow-hidden rounded-full bg-gradient-to-br from-primary to-accent text-xl font-bold tracking-wide text-white shadow-[0_10px_30px_-10px_var(--glow-primary)]">
              <span>{m.initials}</span>
              {/* Photo covers the monogram once present; falls back to initials if missing. */}
              <img
                src={m.photo}
                alt={`${m.name} — ${m.role}`}
                width="96"
                height="96"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover object-center"
                onerror="this.remove()"
              />
            </div>
            <p class="mt-5 text-lg font-bold text-text">{m.name}</p>
            <p class="mt-0.5 text-xs font-semibold uppercase tracking-wider text-primary">{m.role}</p>
            <p class="mt-4 text-sm leading-relaxed text-muted">{m.quote}</p>
          </article>
        ))
      }
    </div>

    <div
      data-reveal
      class="mx-auto mt-10 flex w-fit flex-wrap items-center justify-center gap-x-10 gap-y-4 rounded-[var(--radius-lg)] border border-border bg-surface/40 px-8 py-5"
    >
      {
        team.experience.map((stat) => (
          <div class="text-center">
            <p class="text-gradient text-3xl font-extrabold">{stat.value}</p>
            <p class="mt-1 text-sm text-muted">{stat.label}</p>
          </div>
        ))
      }
    </div>

    <p data-reveal class="mx-auto mt-10 max-w-prose text-center text-lg leading-relaxed text-muted">
      {team.conclusion}
    </p>
  </div>
</section>
