---
import { why } from "../config";
import SectionHeading from "./SectionHeading.astro";
---

<section id="why" class="relative py-16">
  <div class="container">
    <SectionHeading overline={why.overline} title={why.heading} align="center" />

    <div class="mx-auto mt-12 grid max-w-5xl gap-5 sm:grid-cols-2">
      {
        why.observations.map((o, i) => (
          <article
            data-reveal
            style={`--reveal-delay:${(i % 2) * 90}ms`}
            class="group relative overflow-hidden rounded-[var(--radius-lg)] border border-border bg-surface/50 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-[0_20px_50px_-24px_var(--glow-primary)]"
          >
            <div
              class="pointer-events-none absolute -right-10 -top-10 h-28 w-28 rounded-full bg-[radial-gradient(circle,var(--glow-primary),transparent_70%)] opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              aria-hidden="true"
            />
            <h3 class="text-lg font-bold leading-snug text-text">{o.title}</h3>
            <div class="mt-3 space-y-2 text-sm leading-relaxed text-muted">
              {o.body.split(/(?<=\.)\s+/).map((s) => (
                <p>{s}</p>
              ))}
            </div>
          </article>
        ))
      }
    </div>

    <p
      data-reveal
      class="mx-auto mt-12 max-w-prose text-center text-xl font-semibold leading-snug text-text sm:text-2xl"
    >
      {why.closing}
    </p>

    <p
      data-reveal
      style="--reveal-delay:80ms"
      class="text-gradient mx-auto mt-4 max-w-prose text-center text-2xl font-extrabold leading-snug"
    >
      {why.bridge}
    </p>
  </div>
</section>
